{
  "name": "vettid.org",
  "version": "0.1.0",
  "bin": {
    "vettid.org": "bin/vettid.org.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:site": "cdk deploy VettidOrgStack --require-approval never",
    "deploy:all": "cdk deploy --all --require-approval never",
    "sync:nav": "node scripts/sync-nav.mjs",
    "check:site": "node scripts/sync-nav.mjs --check && node scripts/check-site.mjs && node scripts/sync-site-assets.mjs --check",
    "sync:assets": "node scripts/sync-site-assets.mjs",
    "check:manifest": "ts-node --transpile-only --prefer-ts-exts scripts/vault/check-manifest.ts",
    "release-log": "ts-node --transpile-only --prefer-ts-exts scripts/vault/release-log.ts",
    "vault:manifest": "ts-node --transpile-only --prefer-ts-exts scripts/vault/manifest.ts",
    "staging:seed": "ts-node --transpile-only --prefer-ts-exts scripts/staging/seed.ts",
    "staging:mail": "ts-node --transpile-only --prefer-ts-exts scripts/staging/mail.ts",
    "drift": "ts-node --transpile-only --prefer-ts-exts scripts/ops/drift-check.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-auto-scaling": "^3.1146.0",
    "@aws-sdk/client-cloudformation": "^3.1146.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1144.0",
    "@aws-sdk/client-dynamodb": "^3.1144.0",
    "@aws-sdk/client-kms": "^3.1147.0",
    "@aws-sdk/client-lambda": "^3.1145.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/client-secrets-manager": "^3.1144.0",
    "@aws-sdk/client-ses": "^3.1146.0",
    "@aws-sdk/client-sesv2": "^3.1144.0",
    "@aws-sdk/client-sqs": "^3.1145.0",
    "@aws-sdk/client-ssm": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "aws-cdk": "^2.1144.0",
    "aws-jwt-verify": "^5.2.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jsqr": "1.4.0",
    "pdf-lib": "^1.17.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.0.0"
  },
  "description": "Infrastructure (AWS CDK) and static website for vettid.org",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/vettid/vettid.org.git"
  },
  "engines": {
    "node": ">=20"
  }
}
