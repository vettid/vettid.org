{
  "name": "vettid.org",
  "version": "0.1.0",
  "bin": {
    "vettid.org": "bin/vettid.org.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:site": "cdk deploy VettidOrgStack --require-approval never",
    "deploy:all": "cdk deploy --all --require-approval never",
    "sync:nav": "node scripts/sync-nav.mjs",
    "check:site": "node scripts/sync-nav.mjs --check && node scripts/check-site.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "26.3.0",
    "aws-cdk": "2.1136.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.264.0",
    "constructs": "^10.0.0"
  },
  "description": "Infrastructure (AWS CDK) and static website for vettid.org",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/vettid/vettid.org.git"
  },
  "engines": {
    "node": ">=20"
  }
}